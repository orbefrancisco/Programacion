---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate } = Astro.props;
---

<html lang="es">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<article class="longform">
			<header class="post-header">
				<div class="meta">
					<FormattedDate date={pubDate} />
					{updatedDate && (
						<span class="updated">· actualizado <FormattedDate date={updatedDate} /></span>
					)}
				</div>
				<h1>{title}</h1>
				{description && <p class="lede">{description}</p>}
			</header>
			<div class="prose">
				<slot />
			</div>
		</article>
		<Footer />
	</body>
</html>

<style is:global>
	/* Longform layout: a 3-column grid with a named `content` column for prose
	   and a wider `breakout` band for visualizations that need to breathe. */
	.longform {
		display: grid;
		grid-template-columns:
			[full-start] minmax(1em, 1fr)
			[breakout-start] minmax(0, 240px)
			[content-start] minmax(0, 680px) [content-end]
			minmax(0, 240px) [breakout-end]
			minmax(1em, 1fr) [full-end];
		padding: 3em 0 2em;
	}
	.longform > * {
		grid-column: content;
		min-width: 0;
	}
	.longform > .breakout,
	.longform .viz-frame {
		grid-column: breakout;
	}
	.longform > .full-bleed {
		grid-column: full;
	}

	.longform .post-header {
		margin-bottom: 2.8em;
		padding-bottom: 1.4em;
		border-bottom: 1px solid var(--border);
	}
	.longform .meta {
		font-family: var(--font-sans);
		font-size: 0.82rem;
		color: var(--muted);
		margin-bottom: 0.8em;
	}
	.longform h1 {
		margin: 0 0 0.4em;
		font-size: 2.4rem;
	}
	.longform .lede {
		color: var(--muted);
		font-size: 1.1em;
		margin: 0.6em 0 0;
		max-width: 52ch;
	}
	.longform .prose h2 {
		margin-top: 3.5em;
		font-size: 1.45rem;
	}
	.longform .prose h3 {
		margin-top: 2.4em;
		font-size: 1.1rem;
	}
	.longform .prose p {
		max-width: 66ch;
		font-size: 1.02rem;
	}
	.longform .prose li { max-width: 64ch; }

	@media (max-width: 900px) {
		.longform {
			grid-template-columns:
				[full-start] 1em
				[breakout-start content-start] 1fr [content-end breakout-end]
				1em [full-end];
		}
	}
</style>
