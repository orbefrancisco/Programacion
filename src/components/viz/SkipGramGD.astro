---
import VizControls from './VizControls.astro';
import VizFrame from './VizFrame.astro';
---

<VizFrame
	title="Skip-gram: descenso de gradiente en vivo"
	number="Viz 03"
	caption="Embeddings de 8 palabras en 2D. Cada paso procesa un mini-batch de pares (centro, contexto) positivos y k=3 negativos por pareja con la loss SGNS. La estructura semántica emerge en segundos."
>
	<div class="wrap" data-viz="viz-skip">
		<svg viewBox="0 0 640 360" role="img" aria-label="Simulación de gradient descent para skip-gram">
			<g class="axes">
				<line x1="20" y1="180" x2="620" y2="180" />
				<line x1="320" y1="20" x2="320" y2="340" />
			</g>
			<g data-pairs></g>
			<g data-points></g>
		</svg>
	</div>
	<VizControls>
		<button class="btn" type="button" data-play>Iniciar</button>
		<button class="btn" type="button" data-step>Un paso</button>
		<button class="btn" type="button" data-reset>Reiniciar</button>
		<div class="stats">
			<span>Iteración: <span class="value" data-it>0</span></span>
			<span style="margin-left:2em">Loss: <span class="value" data-loss>—</span></span>
		</div>
	</VizControls>

	<style>
		.wrap { width: 100%; }
		svg { width: 100%; height: auto; display: block; }
		.axes line { stroke: var(--faint); stroke-width: 1; }
		.stats {
			font-family: var(--font-sans);
			font-size: 0.82rem;
			color: var(--muted);
		}
	</style>

	<script>
		import { VOCAB, PAIRS } from '../../data/toy-corpus';
		import { seededRng, gaussian } from '../../lib/viz/math';

		const root = document.querySelector<HTMLDivElement>('[data-viz="viz-skip"]');
		if (!root) throw new Error();
		const svg = root.querySelector('svg')!;
		const pointsG = svg.querySelector<SVGGElement>('[data-points]')!;
		const pairsG  = svg.querySelector<SVGGElement>('[data-pairs]')!;
		const itEl    = root.querySelector<HTMLSpanElement>('[data-it]')!;
		const lossEl  = root.querySelector<HTMLSpanElement>('[data-loss]')!;
		const playBtn = root.querySelector<HTMLButtonElement>('[data-play]')!;
		const stepBtn = root.querySelector<HTMLButtonElement>('[data-step]')!;
		const resetBtn= root.querySelector<HTMLButtonElement>('[data-reset]')!;

		const svgns = 'http://www.w3.org/2000/svg';
		const V = VOCAB.length;
		const D = 2;
		const LR = 0.05;
		const K_NEG = 3;

		let W = new Array(V).fill(0).map(() => new Array(D).fill(0)); // input
		let C = new Array(V).fill(0).map(() => new Array(D).fill(0)); // context (output)
		let rng = seededRng(7);
		let iter = 0;
		let running = false;
		let rafId = 0;

		function init() {
			rng = seededRng(7);
			W = W.map(() => Array.from({ length: D }, () => gaussian(rng, 0, 0.25)));
			C = C.map(() => Array.from({ length: D }, () => gaussian(rng, 0, 0.25)));
			iter = 0;
			lossEl.textContent = '—';
			render(0);
		}

		const sigmoid = (x: number) => 1 / (1 + Math.exp(-x));

		function sampleNegative(exclude: number): number {
			while (true) {
				const k = Math.floor(rng() * V);
				if (k !== exclude) return k;
			}
		}

		// One pass over all pairs
		function epoch(): number {
			let total = 0;
			// Shuffle pairs
			const order = PAIRS.slice();
			for (let i = order.length - 1; i > 0; i--) {
				const j = Math.floor(rng() * (i + 1));
				[order[i], order[j]] = [order[j], order[i]];
			}
			for (const [i, j] of order) {
				// positive: σ(W_i · C_j) should be 1
				const pos = W[i][0]*C[j][0] + W[i][1]*C[j][1];
				const pSig = sigmoid(pos);
				total += -Math.log(pSig + 1e-9);
				// grad W_i += (pSig - 1) * C_j
				const gWi = [(pSig - 1) * C[j][0], (pSig - 1) * C[j][1]];
				const gCj = [(pSig - 1) * W[i][0], (pSig - 1) * W[i][1]];

				// negatives
				for (let n = 0; n < K_NEG; n++) {
					const k = sampleNegative(j);
					const neg = W[i][0]*C[k][0] + W[i][1]*C[k][1];
					const nSig = sigmoid(neg);
					total += -Math.log(1 - nSig + 1e-9);
					gWi[0] += nSig * C[k][0];
					gWi[1] += nSig * C[k][1];
					// grad C_k
					C[k][0] -= LR * (nSig * W[i][0]);
					C[k][1] -= LR * (nSig * W[i][1]);
				}

				W[i][0] -= LR * gWi[0];
				W[i][1] -= LR * gWi[1];
				C[j][0] -= LR * gCj[0];
				C[j][1] -= LR * gCj[1];
			}
			return total / order.length;
		}

		function el<K extends keyof SVGElementTagNameMap>(name: K): SVGElementTagNameMap[K] {
			return document.createElementNS(svgns, name);
		}

		const GROUP_COLOR: Record<string, string> = {
			king: '#F59E0B', queen: '#F59E0B',
			man: '#A7A7AE', woman: '#A7A7AE',
			dog: '#6FB28F', cat: '#6FB28F',
			runs: '#CFCF8D', sleeps: '#CFCF8D',
		};

		function render(loss: number) {
			// Compute plot range
			let minx = Infinity, maxx = -Infinity, miny = Infinity, maxy = -Infinity;
			for (const v of W) {
				if (v[0] < minx) minx = v[0]; if (v[0] > maxx) maxx = v[0];
				if (v[1] < miny) miny = v[1]; if (v[1] > maxy) maxy = v[1];
			}
			const cx = (minx + maxx) / 2, cy = (miny + maxy) / 2;
			const r = Math.max(0.5, Math.max(maxx - minx, maxy - miny) / 2) * 1.15;
			const plot = (x: number, y: number) => ({
				x: 320 + (x - cx) / r * 280,
				y: 180 - (y - cy) / r * 150,
			});

			while (pointsG.firstChild) pointsG.removeChild(pointsG.firstChild);
			while (pairsG.firstChild) pairsG.removeChild(pairsG.firstChild);

			// Draw faint positive-pair segments (input→context)
			for (const [i, j] of PAIRS) {
				const a = plot(W[i][0], W[i][1]);
				const b = plot(C[j][0], C[j][1]);
				const line = el('line');
				line.setAttribute('x1', String(a.x));
				line.setAttribute('y1', String(a.y));
				line.setAttribute('x2', String(b.x));
				line.setAttribute('y2', String(b.y));
				line.setAttribute('stroke', 'var(--border)');
				line.setAttribute('stroke-width', '0.5');
				pairsG.appendChild(line);
			}

			// Draw word points (input embeddings)
			for (let i = 0; i < V; i++) {
				const p = plot(W[i][0], W[i][1]);
				const c = el('circle');
				c.setAttribute('cx', String(p.x));
				c.setAttribute('cy', String(p.y));
				c.setAttribute('r', '5');
				c.setAttribute('fill', GROUP_COLOR[VOCAB[i]] ?? 'var(--fg)');
				pointsG.appendChild(c);
				const t = el('text');
				t.setAttribute('x', String(p.x + 8));
				t.setAttribute('y', String(p.y + 4));
				t.setAttribute('fill', 'var(--fg)');
				t.setAttribute('font-family', 'var(--font-sans)');
				t.setAttribute('font-size', '11');
				t.textContent = VOCAB[i];
				pointsG.appendChild(t);
			}

			if (loss > 0) lossEl.textContent = loss.toFixed(3);
			itEl.textContent = String(iter);
		}

		function step() {
			const loss = epoch();
			iter++;
			render(loss);
		}

		function loop() {
			if (!running) return;
			step();
			rafId = requestAnimationFrame(loop);
		}

		playBtn.addEventListener('click', () => {
			running = !running;
			playBtn.textContent = running ? 'Pausar' : 'Iniciar';
			if (running) loop(); else cancelAnimationFrame(rafId);
		});
		stepBtn.addEventListener('click', step);
		resetBtn.addEventListener('click', () => {
			running = false;
			playBtn.textContent = 'Iniciar';
			cancelAnimationFrame(rafId);
			init();
		});

		init();
	</script>
</VizFrame>
