---
import VizControls from './VizControls.astro';
import VizFrame from './VizFrame.astro';
---

<VizFrame
	title="Concentración de medida sobre la n-esfera"
	number="Viz 04"
	caption="Histograma de similitudes coseno entre pares de vectores Gaussianos normalizados en R^d. A medida que d crece, la distribución colapsa sobre 0: la dirección entre dos puntos aleatorios casi siempre es ortogonal."
>
	<div class="wrap" data-viz="viz-dist">
		<svg viewBox="0 0 640 320" role="img" aria-label="Distribución de similitudes coseno variando la dimensión">
			<g class="axes">
				<line x1="40"  y1="260" x2="620" y2="260" />
				<line x1="330" y1="260" x2="330" y2="30" />
				<text x="42"  y="280" text-anchor="start">−1</text>
				<text x="330" y="280" text-anchor="middle">0</text>
				<text x="618" y="280" text-anchor="end">+1</text>
				<text x="330" y="300" text-anchor="middle">similitud coseno</text>
			</g>
			<g data-bars></g>
			<g data-stats></g>
		</svg>
	</div>
	<VizControls>
		<label>
			<span>Dimensión d</span>
			<input type="range" data-dim min="1" max="3" step="0.01" value="0.3" aria-label="Dimensión (escala log)" />
			<span class="value" data-dim-label>2</span>
		</label>
		<div class="stats">
			<span>media: <span class="value" data-mean>—</span></span>
			<span style="margin-left:2em">σ: <span class="value" data-std>—</span></span>
		</div>
	</VizControls>

	<style>
		.wrap { width: 100%; }
		svg { width: 100%; height: auto; display: block; }
		.axes line { stroke: var(--faint); stroke-width: 1; }
		.axes text {
			fill: var(--muted);
			font-family: var(--font-sans);
			font-size: 11px;
		}
		.stats {
			font-family: var(--font-sans);
			font-size: 0.82rem;
			color: var(--muted);
		}
	</style>

	<script>
		import { seededRng, gaussian } from '../../lib/viz/math';

		const root = document.querySelector<HTMLDivElement>('[data-viz="viz-dist"]');
		if (!root) throw new Error();
		const svg = root.querySelector('svg')!;
		const barsG  = svg.querySelector<SVGGElement>('[data-bars]')!;
		const statsG = svg.querySelector<SVGGElement>('[data-stats]')!;
		const dimInput = root.querySelector<HTMLInputElement>('[data-dim]')!;
		const dimLabel = root.querySelector<HTMLSpanElement>('[data-dim-label]')!;
		const meanEl   = root.querySelector<HTMLSpanElement>('[data-mean]')!;
		const stdEl    = root.querySelector<HTMLSpanElement>('[data-std]')!;

		const svgns = 'http://www.w3.org/2000/svg';

		const N_PAIRS = 4000;
		const BINS = 50;
		const MIN_X = 40, MAX_X = 620, MIN_Y = 30, BASELINE = 260;
		const rng = seededRng(42);

		function dimFromSlider(v: number): number {
			// Map slider [1, 3] to dim [2, 1000] on log scale
			const d = Math.round(Math.pow(10, v));
			return Math.max(2, Math.min(1000, d));
		}

		function sampleCos(d: number): number {
			let aDot = 0, aNorm = 0, bNorm = 0;
			for (let k = 0; k < d; k++) {
				const x = gaussian(rng);
				const y = gaussian(rng);
				aDot += x * y;
				aNorm += x * x;
				bNorm += y * y;
			}
			return aDot / (Math.sqrt(aNorm * bNorm) || 1);
		}

		function el<K extends keyof SVGElementTagNameMap>(name: K): SVGElementTagNameMap[K] {
			return document.createElementNS(svgns, name);
		}

		function render(d: number) {
			const counts = new Array<number>(BINS).fill(0);
			let sum = 0, sum2 = 0;
			for (let p = 0; p < N_PAIRS; p++) {
				const c = sampleCos(d);
				sum += c; sum2 += c * c;
				const idx = Math.min(BINS - 1, Math.max(0, Math.floor(((c + 1) / 2) * BINS)));
				counts[idx]++;
			}
			const mean = sum / N_PAIRS;
			const varc = Math.max(0, sum2 / N_PAIRS - mean * mean);
			const std = Math.sqrt(varc);

			while (barsG.firstChild) barsG.removeChild(barsG.firstChild);
			while (statsG.firstChild) statsG.removeChild(statsG.firstChild);

			const maxCount = Math.max(...counts, 1);
			const binW = (MAX_X - MIN_X) / BINS;
			for (let i = 0; i < BINS; i++) {
				const h = (counts[i] / maxCount) * (BASELINE - MIN_Y);
				const r = el('rect');
				r.setAttribute('x', String(MIN_X + i * binW));
				r.setAttribute('y', String(BASELINE - h));
				r.setAttribute('width', String(Math.max(0.5, binW - 1)));
				r.setAttribute('height', String(h));
				r.setAttribute('fill', 'var(--accent)');
				r.setAttribute('opacity', '0.85');
				barsG.appendChild(r);
			}

			// mean marker
			const mx = MIN_X + ((mean + 1) / 2) * (MAX_X - MIN_X);
			const mLine = el('line');
			mLine.setAttribute('x1', String(mx));
			mLine.setAttribute('y1', String(MIN_Y));
			mLine.setAttribute('x2', String(mx));
			mLine.setAttribute('y2', String(BASELINE));
			mLine.setAttribute('stroke', 'var(--fg)');
			mLine.setAttribute('stroke-width', '0.8');
			mLine.setAttribute('stroke-dasharray', '3 3');
			statsG.appendChild(mLine);

			meanEl.textContent = mean.toFixed(3);
			stdEl.textContent  = std.toFixed(3);
			dimLabel.textContent = String(d);
		}

		let timeout = 0;
		dimInput.addEventListener('input', () => {
			const d = dimFromSlider(Number(dimInput.value));
			dimLabel.textContent = String(d);
			if (timeout) clearTimeout(timeout);
			timeout = window.setTimeout(() => render(d), 40);
		});

		render(dimFromSlider(Number(dimInput.value)));
	</script>
</VizFrame>
