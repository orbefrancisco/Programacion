---
import { SITE_TITLE } from '../consts';
import DarkToggle from './DarkToggle.astro';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav>
		<a href={import.meta.env.BASE_URL} class="brand">{SITE_TITLE}</a>
		<div class="nav-links">
			<HeaderLink href={import.meta.env.BASE_URL}>Home</HeaderLink>
			<HeaderLink href={`${import.meta.env.BASE_URL}blog`}>Blog</HeaderLink>
			<DarkToggle />
		</div>
	</nav>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--border);
		background: var(--bg);
	}
	nav {
		max-width: 1080px;
		margin: 0 auto;
		padding: 0.9em 1.4em;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}
	.brand {
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 0.98rem;
		color: var(--fg);
		letter-spacing: -0.01em;
		border-bottom: none;
	}
	.brand:hover { color: var(--accent); }
	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.8em;
		font-family: var(--font-sans);
		font-size: 0.9rem;
	}
</style>
