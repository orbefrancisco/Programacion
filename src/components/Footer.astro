---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div>
		<span>&copy; {year} DuroBlog</span>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--border);
		margin-top: 6em;
		padding: 2em 1.4em;
		color: var(--muted);
		font-family: var(--font-sans);
		font-size: 0.85rem;
	}
	.site-footer > div {
		max-width: 1080px;
		margin: 0 auto;
	}
</style>
