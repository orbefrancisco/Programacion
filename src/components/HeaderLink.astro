---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const base = import.meta.env.BASE_URL;
const stripBase = (p: string) => (p.startsWith(base) ? p.slice(base.length - 1) : p);
const pathname = stripBase(Astro.url.pathname);
const hrefPath = typeof href === 'string' ? stripBase(href) : '';
const isActive =
	hrefPath === pathname ||
	(hrefPath !== '/' && pathname.startsWith(hrefPath + '/')) ||
	(hrefPath === '/' && pathname === '/');
---

<a href={href} class:list={[className, 'nav-link', { active: isActive }]} {...props}>
	<slot />
</a>

<style>
	.nav-link {
		color: var(--muted);
		border-bottom: 1px solid transparent;
		padding-bottom: 1px;
		transition: color 120ms ease, border-color 120ms ease;
	}
	.nav-link:hover { color: var(--fg); }
	.nav-link.active { color: var(--fg); border-bottom-color: var(--accent); }
</style>
